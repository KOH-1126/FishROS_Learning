cmake_minimum_required(VERSION 3.8)
project(ros2_cpp)
add_executable(ros2_cpp_node_hahaha ros2_cpp_node.cpp)

find_package(rclcpp REQUIRED) # 查找对应的头文件和库文件
# message(STATUS ${rclcpp_INCLUDE_DIRS}) # 头文件
# message(STATUS ${rclcpp_LIBRARIES}) # 库文件

target_include_directories(ros2_cpp_node_hahaha PUBLIC ${rclcpp_INCLUDE_DIRS}) # 头文件包含
target_link_libraries(ros2_cpp_node_hahaha ${rclcpp_LIBRARIES}) # 库文件链接